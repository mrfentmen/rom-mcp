{
  "name": "rom-mcp",
  "version": "1.0.0",
  "description": "MCP server for searching, verifying, and managing game ROM collections. Search Internet Archive, verify checksums, parse save files.",
  "type": "module",
  "bin": {
    "rom-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "/opt/homebrew/bin/tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "rm -rf dist && /opt/homebrew/bin/tsc -p tsconfig.json && node dist/index.js"
  },
  "keywords": [
    "mcp",
    "rom",
    "emulator",
    "retro-gaming",
    "game",
    "checksum",
    "no-intro",
    "redump"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
